<!DOCTYPE html>
<html>

<head>

    <title>Tambah Sidang</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

</head>

<body>

<div class="container mt-4">

    <h1>Tambah Sidang</h1>

    <a href="/sidang" class="btn btn-secondary mb-3">
        Kembali
    </a>

    <form action="/sidang/tambah" method="POST">

        <div class="mb-3">

            <label>Mahasiswa</label>

            <select name="id_mahasiswa" class="form-control">

                <% mahasiswa.forEach(m=>{ %>

                    <option value="<%= m.id_mahasiswa %>">

                        <%= m.npm %> -
                        <%= m.nama %>

                    </option>

                <% }) %>

            </select>

        </div>

        <div class="mb-3">

            <label>Pembimbing</label>

            <select name="pembimbing" class="form-control">

                <% dosen.forEach(d=>{ %>

                    <option value="<%= d.id_dosen %>">

                        <%= d.nama %>

                    </option>

                <% }) %>

            </select>

        </div>

        <div class="mb-3">

            <label>Penguji 1</label>

            <select name="penguji_1" class="form-control">

                <% dosen.forEach(d=>{ %>

                    <option value="<%= d.id_dosen %>">

                        <%= d.nama %>

                    </option>

                <% }) %>

            </select>

        </div>

        <div class="mb-3">

            <label>Penguji 2</label>

            <select name="penguji_2" class="form-control">

                <% dosen.forEach(d=>{ %>

                    <option value="<%= d.id_dosen %>">

                        <%= d.nama %>

                    </option>

                <% }) %>

            </select>

        </div>

        <div class="mb-3">

            <label>Penguji 3</label>

            <select name="penguji_3" class="form-control">

                <% dosen.forEach(d=>{ %>

                    <option value="<%= d.id_dosen %>">

                        <%= d.nama %>

                    </option>

                <% }) %>

            </select>

        </div>

        <div class="mb-3">

            <label>Tanggal</label>

            <input
                type="date"
                name="tanggal"
                class="form-control"
                required>

        </div>

        <div class="mb-3">

            <label>Jam</label>

            <input
                type="time"
                name="jam"
                class="form-control"
                required>

        </div>

        <div class="mb-3">

            <label>Ruang</label>

            <input
                type="text"
                name="ruang"
                class="form-control"
                required>

        </div>

        <button class="btn btn-success">

            Simpan

        </button>

    </form>

</div>

</body>
</html>