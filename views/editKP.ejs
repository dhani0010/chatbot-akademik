<!DOCTYPE html>
<html>

<head>

    <title>Edit Kerja Praktik</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

</head>

<body>

<div class="container mt-4">

    <h1>Edit Data Kerja Praktik</h1>

    <a href="/kp" class="btn btn-secondary mb-3">
        Kembali
    </a>

    <form action="/kp/edit/<%= kp.id_kp %>" method="POST">

        <div class="mb-3">

            <label>Mahasiswa</label>

            <select
                name="id_mahasiswa"
                class="form-control"
                required>

                <% mahasiswa.forEach(m=>{ %>

                    <option
                        value="<%= m.id_mahasiswa %>"
                        <%= kp.id_mahasiswa == m.id_mahasiswa ? 'selected' : '' %>>

                        <%= m.npm %> - <%= m.nama %>

                    </option>

                <% }) %>

            </select>

        </div>

        <div class="mb-3">

            <label>Judul KP</label>

            <input
                type="text"
                name="judul"
                class="form-control"
                value="<%= kp.judul %>"
                required>

        </div>

        <div class="mb-3">

            <label>Dosen Pembimbing</label>

            <select
                name="dosen_pembimbing"
                class="form-control"
                required>

                <% dosen.forEach(d=>{ %>

                    <option
                        value="<%= d.id_dosen %>"
                        <%= kp.dosen_pembimbing == d.id_dosen ? 'selected' : '' %>>

                        <%= d.nama %>

                    </option>

                <% }) %>

            </select>

        </div>

        <div class="mb-3">
            <label>Tahun</label>
            <input type="number" name="tahun" class="form-control" required>
        </div>

        <button
            type="submit"
            class="btn btn-primary">

            Update

        </button>

    </form>

</div>

</body>

</html>