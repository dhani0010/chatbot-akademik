<!DOCTYPE html>
<html>

<head>

    <title>Jadwal Kuliah</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

</head>

<body>

    <div class="container mt-4">

        <h2>Edit FAQ</h2>

        <form action="/faq/edit/<%= faq.id %>" method="POST">

            <div class="mb-3">

                <label>Pertanyaan</label>

                <input type="text" name="pertanyaan" class="form-control" value="<%= faq.pertanyaan %>">

            </div>

            <div class="mb-3">

                <label>Jawaban</label>

                <textarea name="jawaban" class="form-control"><%= faq.jawaban %></textarea>

            </div>

            <div class="mb-3">

                <label>Kategori</label>

                <input type="text" name="kategori" class="form-control" value="<%= faq.kategori %>">

            </div>

            <button class="btn btn-primary">

                Update

            </button>

            </button>

            <a href="/faq" class="btn btn-secondary">

                Kembali

            </a>

        </form>

    </div>

</body>

</html>