<!DOCTYPE html>
<html>
<head>

    <title>Tambah KKN</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

</head>
<body>

<div class="container mt-4">

    <h1>Tambah KKN</h1>

    <a href="/kkn" class="btn btn-secondary mb-3">
        Kembali
    </a>

    <form action="/kkn/tambah" method="POST">

        <div class="mb-3">

            <label>Mahasiswa</label>

            <select name="id_mahasiswa" class="form-control">

                <% mahasiswa.forEach(m=>{ %>

                <option value="<%= m.id_mahasiswa %>">
                    <%= m.npm %> - <%= m.nama %>
                </option>

                <% }) %>

            </select>

        </div>

        <div class="mb-3">
            <label>Lokasi</label>
            <input type="text"
                   name="lokasi"
                   class="form-control"
                   required>
        </div>

        <div class="mb-3">
            <label>Kelompok</label>
            <input type="text"
                   name="kelompok"
                   class="form-control">
        </div>

        <div class="mb-3">

            <label>Dosen Pembimbing</label>

            <select
                name="dosen_pembimbing"
                class="form-control">

                <% dosen.forEach(d=>{ %>

                <option value="<%= d.id_dosen %>">
                    <%= d.nama %>
                </option>

                <% }) %>

            </select>

        </div>

        <div class="mb-3">
            <label>Periode</label>
            <input type="text"
                   name="periode"
                   class="form-control">
        </div>

        <div class="mb-3">

            <label>Status</label>

            <select name="status"
                    class="form-control">

                <option>Pengajuan</option>
                <option>Proses</option>
                <option>Selesai</option>

            </select>

        </div>

        <button class="btn btn-success">
            Simpan
        </button>

    </form>

</div>

</body>
</html>