<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">

<title>Edit Dosen</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

<style>

body{
    background:#f5f6fa;
}

.card-form{
    border:none;
    border-radius:15px;
}

</style>

</head>
<body>

<div class="container mt-5">

    <h1 class="mb-4">
        Edit Dosen
    </h1>

    <a href="/dosen"
       class="btn btn-secondary mb-3">

        Kembali

    </a>

    <div class="card card-form shadow">

        <div class="card-body">

            <form
                action="/dosen/edit/<%= dosen.id_dosen %>"
                method="POST">

                <div class="mb-3">

                    <label class="form-label">

                        Nama Dosen

                    </label>

                    <input
                        type="text"
                        name="nama"
                        class="form-control"
                        value="<%= dosen.nama %>"
                        required>

                </div>

                <div class="mb-3">

                    <label class="form-label">

                        Kode Dosen

                    </label>

                    <input
                        type="text"
                        name="kode"
                        class="form-control"
                        value="<%= dosen.kode %>"
                        required>

                </div>

                <button
                    type="submit"
                    class="btn btn-primary">

                    Update

                </button>

            </form>

        </div>

    </div>

</div>

</body>
</html>