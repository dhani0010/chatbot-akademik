<!DOCTYPE html>
<html>
<head>

    <title>Edit KKN</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

</head>
<body>

<div class="container mt-4">

    <h1>Edit KKN</h1>

    <a href="/kkn" class="btn btn-secondary mb-3">
        Kembali
    </a>

    <form action="/kkn/edit/<%= kkn.id_kkn %>" method="POST">

        <div class="mb-3">

            <label>Mahasiswa</label>

            <select name="id_mahasiswa" class="form-control">

                <% mahasiswa.forEach(m=>{ %>

                <option value="<%= m.id_mahasiswa %>"
                    <%= kkn.id_mahasiswa == m.id_mahasiswa ? 'selected' : '' %>>
                    <%= m.npm %> - <%= m.nama %>
                </option>

                <% }) %>

            </select>

        </div>

        <div class="mb-3">
            <label>Lokasi</label>
            <input type="text"
                   name="lokasi"
                   value="<%= kkn.lokasi %>"
                   class="form-control">
        </div>

        <div class="mb-3">
            <label>Kelompok</label>
            <input type="text"
                   name="kelompok"
                   value="<%= kkn.kelompok %>"
                   class="form-control">
        </div>

        <div class="mb-3">

            <label>Dosen Pembimbing</label>

            <select name="dosen_pembimbing"
                    class="form-control">

                <% dosen.forEach(d=>{ %>

                <option value="<%= d.id_dosen %>"
                    <%= kkn.dosen_pembimbing == d.id_dosen ? 'selected' : '' %>>
                    <%= d.nama %>
                </option>

                <% }) %>

            </select>

        </div>

        <div class="mb-3">
            <label>Periode</label>
            <input type="text"
                   name="periode"
                   value="<%= kkn.periode %>"
                   class="form-control">
        </div>

        <div class="mb-3">

            <label>Status</label>

            <select name="status"
                    class="form-control">

                <option value="Pengajuan"
                    <%= kkn.status=='Pengajuan' ? 'selected' : '' %>>
                    Pengajuan
                </option>

                <option value="Proses"
                    <%= kkn.status=='Proses' ? 'selected' : '' %>>
                    Proses
                </option>

                <option value="Selesai"
                    <%= kkn.status=='Selesai' ? 'selected' : '' %>>
                    Selesai
                </option>

            </select>

        </div>

        <button class="btn btn-primary">
            Update
        </button>

    </form>

</div>

</body>
</html>