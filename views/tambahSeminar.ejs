<!DOCTYPE html>
<html>

<head>

    <title>Tambah Seminar</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

</head>

<body>

    <div class="container mt-4">

        <h1>Tambah Seminar</h1>

        <a href="/seminar" class="btn btn-secondary mb-3">
            Kembali
        </a>

        <form action="/seminar/tambah" method="POST">

            <label>Mahasiswa</label>

            <select name="id_mahasiswa" class="form-control">

                <% mahasiswa.forEach(m=>{ %>

                    <option value="<%= m.id_mahasiswa %>">
                        <%= m.npm %> - <%= m.nama %>
                    </option>

                    <% }) %>

            </select>

            <label>Tanggal</label>
            <input type="date" name="tanggal" class="form-control">

            <label>Ruang</label>
            <input type="text" name="ruang" class="form-control">

            <label>Pembimbing</label>

            <select name="pembimbing" class="form-control">

                <% dosen.forEach(d=>{ %>

                    <option value="<%= d.id_dosen %>">
                        <%= d.nama %>
                    </option>

                    <% }) %>

            </select>

            <label>Penguji</label>

            <select name="penguji_1" class="form-control">

                <% dosen.forEach(d=>{ %>

                    <option value="<%= d.id_dosen %>">
                        <%= d.nama %>
                    </option>

                    <% }) %>

            </select>

            <label>Penguji 2</label>

            <select name="penguji_2" class="form-control">

                <% dosen.forEach(d=>{ %>

                    <option value="<%= d.id_dosen %>">
                        <%= d.nama %>
                    </option>

                    <% }) %>

            </select>

            <br>

            <button class="btn btn-success">
                Simpan
            </button>

        </form>

    </div>

</body>

</html>