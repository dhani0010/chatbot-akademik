<!DOCTYPE html>
<html>

<head>

    <title>Edit KP</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

</head>

<body>

    <div class="container mt-4">

        <h1>Edit KP</h1>

        <a href="/kp" class="btn btn-secondary mb-3">
            Kembali
        </a>

        <form action="/kp/tambah" method="POST">

            <div class="mb-3">

                <label>Mahasiswa</label>

                <select name="id_mahasiswa" class="form-control">

                    <% mahasiswa.forEach(m=>{ %>

                        <option value="<%= m.id_mahasiswa %>">
                            <%= m.npm %> - <%= m.nama %>
                        </option>

                        <% }) %>

                </select>

            </div>

            <div class="mb-3">
                <label>Judul</label>
                <input type="text" name="judul" class="form-control">
            </div>

            <div class="mb-3">

                <label>Dosen Pembimbing</label>

                <select name="dosen_pembimbing" class="form-control">

                    <% dosen.forEach(d=>{ %>

                        <option value="<%= d.id_dosen %>">
                            <%= d.nama %>
                        </option>

                        <% }) %>

                </select>

            </div>


            <div class="mb-3">
                <label>Tahun</label>
                <input type="number" name="tahun" class="form-control" required>
            </div>

            <button class="btn btn-success">

                Simpan

            </button>

            <a href="/kp" class="btn btn-secondary">
                Kembali
            </a>

        </form>

    </div>

</body>

</html>