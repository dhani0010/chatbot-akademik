<!DOCTYPE html>
<html>

<head>

    <title>Edit Judul Skripsi</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

</head>

<body>

<div class="container mt-4">

    <h1>Edit Judul Skripsi</h1>

    <a href="/judulSkripsi" class="btn btn-secondary mb-3">
        Kembali
    </a>

    <form action="/judulSkripsi/edit/<%= judul.id_judul %>" method="POST">

        <div class="mb-3">

            <label>Judul Skripsi</label>

            <textarea
                name="judul"
                class="form-control"
                required><%= judul.judul %></textarea>

        </div>

        <div class="mb-3">
                <label>Mahasiswa</label>
                <select name="id_mahasiswa" class="form-control" required>

                    <% mahasiswa.forEach(m=>{ %>

                        <option value="<%= m.id_mahasiswa %>">
                            <%= m.npm %> - <%= m.nama %>
                        </option>

                        <% }) %>

                </select>
            </div>

        <div class="mb-3">
            <label>Tahun</label>
            <input type="number" name="tahun" class="form-control" required>
        </div>

        <div class="mb-3">

                <label>Dosen Pembimbing 1</label>

                <select name="dosen_pembimbing_1" class="form-control">

                    <% dosen.forEach(d=>{ %>

                        <option value="<%= d.id_dosen %>">

                            <%= d.nama %>

                        </option>

                        <% }) %>

                </select>

            </div>

            <div class="mb-3">

                <label>Dosen Pembimbing 2</label>

                <select name="dosen_pembimbing_2" class="form-control">

                    <% dosen.forEach(d=>{ %>

                        <option value="<%= d.id_dosen %>">

                            <%= d.nama %>

                        </option>

                        <% }) %>

                        <option value="" <%= mahasiswa.semester == 0 ? 'selected' : '' %>>Tidak Ada</option>

                </select>

            </div>

        <button
            type="submit"
            class="btn btn-primary">

            Update

        </button>

    </form>

</div>

</body>
</html>