<!DOCTYPE html>
<html>

<head>

    <title>Data Dokumen</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

</head>

<body>

    <div class="container mt-4">

        <h1>Data Dokumen Akademik</h1>

        <a href="/dashboard" class="btn btn-secondary mb-3">
            Dashboard
        </a>

        <a href="/dokumen/tambah" class="btn btn-success mb-3">
            + Tambah Dokumen
        </a>

        <table class="table table-bordered">

            <thead>

                <tr>

                    <th>ID</th>
                    <th>Nama</th>
                    <th>Kategori</th>
                    <th>File</th>
                    <th>Upload</th>
                    <th>Aksi</th>

                </tr>

            </thead>

            <tbody>

                <% if(data.length> 0){ %>

                    <% data.forEach(item=>{ %>

                        <tr>

                            <td>
                                <%= item.id %>
                            </td>

                            <td>
                                <%= item.nama %>
                            </td>

                            <td>
                                <%= item.kategori %>
                            </td>

                            <td>

                                <a href="/uploads/<%= item.file %>" target="_blank">

                                    Download

                                </a>

                            </td>

                            <td>
                                <%= new Date(item.upload) .toLocaleDateString('id-ID') %>
                            </td>

                            <td>

                                <a href="/dokumen/edit/<%= item.id %>" class="btn btn-warning btn-sm">
                                    Edit
                                </a>

                                <a href="/dokumen/hapus/<%= item.id %>" class="btn btn-danger btn-sm"
                                    onclick="return confirm('Hapus dokumen?')">
                                    Hapus
                                </a>

                            </td>

                        </tr>

                        <% }) %>

                            <% } else { %>

                                <tr>

                                    <td colspan="6" class="text-center">

                                        Belum ada dokumen

                                    </td>

                                </tr>

                                <% } %>

            </tbody>

        </table>

    </div>

</body>

</html>