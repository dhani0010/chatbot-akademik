<!DOCTYPE html>
<html>

<head>

    <title>Tambah Mahasiswa</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

</head>

<body>

    <div class="container mt-4">

        <h1>Tambah Data Skripsi</h1>

        <a href="/skripsi" class="btn btn-secondary mb-3">
            Kembali
        </a>

        <form action="/skripsi/tambah" method="POST">

            <div class="mb-3">
                <label>Mahasiswa</label>
                <select name="id_mahasiswa" class="form-control">

                    <% mahasiswa.forEach(m=>{ %>

                        <option value="<%= m.id_mahasiswa %>">
                            <%= m.npm %> - <%= m.nama %>
                        </option>

                        <% }) %>

                </select>
            </div>

            <div class="mb-3">
                <label>Judul Skripsi</label>
                <textarea name="judul" class="form-control" required></textarea>
            </div>

            <div class="mb-3">
                <label>Pembimbing</label>
                <select name="pembimbing" class="form-control">

                    <% dosen.forEach(d=>{ %>

                        <option value="<%= d.id_dosen %>">
                            <%= d.nama %>
                        </option>

                        <% }) %>

                </select>
            </div>

            <div class="mb-3">
                <label>Tahun</label>
                <input type="number" name="tahun" class="form-control" required>
            </div>

            <div class="mb-3">
                <label>Status</label>

                <select name="status" class="form-control">

                    <option value="Pengajuan">
                        Pengajuan
                    </option>

                    <option value="Proses">
                        Proses
                    </option>

                    <option value="Disetujui">
                        Disetujui
                    </option>

                    <option value="Selesai">
                        Selesai
                    </option>

                </select>

            </div>

            <div class="mb-3">
                <label>Tanggal Sidang</label>

                <input type="date" name="tanggal_sidang" class="form-control">
            </div>

            <button type="submit" class="btn btn-primary">

                Simpan

            </button>

            <a href="/skripsi" class="btn btn-secondary">
                Kembali
            </a>

        </form>

    </div>

</body>

</html>