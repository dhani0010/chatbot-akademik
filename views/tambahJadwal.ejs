<!DOCTYPE html>
<html lang="id">

<head>

    <meta charset="UTF-8">

    <title>Tambah Jadwal Kuliah</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

</head>

<body>

    <div class="container mt-4">

        <div class="card shadow">

            <div class="card-header bg-success text-white">

                <h3>Tambah Jadwal Kuliah</h3>

            </div>

            <div class="card-body">

                <form action="/jadwal/tambah" method="POST">

                    <div class="mb-3">
                        <label>Mata Kuliah</label>
                        <select name="id_mk" class="form-control">

                            <% mataKuliah.forEach(m=>{ %>

                                <option value="<%= m.id_mk %>">
                                    <%= m.kode_mk %> - <%= m.nama_mk %>
                                </option>

                                <% }) %>

                        </select>
                    </div>

                    <div class="mb-3">

                        <label class="form-label">
                            Dosen
                        </label>

                        <select name="id_dosen" class="form-control">

                            <% dosen.forEach(d=>{ %>

                                <option value="<%= d.id_dosen %>">
                                    <%= d.kode %> - <%= d.nama %>
                                </option>

                                <% }) %>

                        </select>

                    </div>

                    <div class="mb-3">
                        <label>Semester</label>
                        <input type="text" name="semester" class="form-control" required>
                    </div>

                    <div class="mb-3">
                        <label>Kelas</label>
                        <input type="text" name="kelas" class="form-control" required>
                    </div>

                    <div class="mb-3">

                        <label class="form-label">
                            Hari
                        </label>

                        <select name="hari" class="form-control">

                            <option>Senin</option>
                            <option>Selasa</option>
                            <option>Rabu</option>
                            <option>Kamis</option>
                            <option>Jumat</option>
                            <option>Sabtu</option>

                        </select>

                    </div>

                    <div class="mb-3">

                        <label class="form-label">
                            Jam Mulai
                        </label>

                        <input type="text" name="jam_mulai" class="form-control" placeholder="08:00" required>

                    </div>

                    <div class="mb-3">

                        <label class="form-label">
                            Jam Selesai
                        </label>

                        <input type="text" name="jam_selesai" class="form-control" placeholder="10:00" required>

                    </div>

                    <div class="mb-3">
                        <label>Ruangan</label>
                        <input type="text" name="ruangan" class="form-control" required>
                    </div>

                    <button type="submit" class="btn btn-primary">

                        Simpan

                    </button>

                    <a href="/jadwal" class="btn btn-secondary">

                        Kembali

                    </a>

                </form>

            </div>

        </div>

    </div>

</body>

</html>