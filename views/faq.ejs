<!DOCTYPE html>
<html>

<head>

    <title>Jadwal Kuliah</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

</head>

<body>

    <div class="container mt-4">

        <div class="d-flex justify-content-between align-items-center mb-4">

            <h2>FAQ</h2>

            <a href="/logout" class="btn btn-danger">
                Logout
            </a>

        </div>

        <a href="/dashboard" class="btn btn-secondary mb-3">

            Dashboard

        </a>

        <a href="/faq/tambah" class="btn btn-success mb-3">

            Tambah Faq

        </a>

        <table class="table table-bordered">

            <thead>

                <tr>

                    <th>No</th>
                    <th>Pertanyaan</th>
                    <th>Jawaban</th>
                    <th>Kategori</th>
                    <th>Aksi</th>

                </tr>

            </thead>

            <tbody>

                <% if(data && data.length> 0){ %>

                    <% data.forEach((item,index)=>{ %>

                        <tr>

                            <td>
                                <%= index+1 %>
                            </td>

                            <td>
                                <%= item.pertanyaan %>
                            </td>

                            <td>
                                <%= item.jawaban %>
                            </td>

                            <td>
                                <%= item.kategori %>
                            </td>

                            <td>

                                <a href="/faq/edit/<%= item.id %>" class="btn btn-warning btn-sm">

                                    Edit

                                </a>

                                <a href="/faq/hapus/<%= item.id %>" class="btn btn-danger btn-sm">

                                    Hapus

                                </a>

                            </td>

                        </tr>

                        <% }) %>

                            <% } else { %>

                                <tr>
                                    <td colspan="5" class="text-center">
                                        Belum ada data FAQ
                                    </td>
                                </tr>

                                <% } %>

            </tbody>

        </table>

    </div>

</body>

</html>