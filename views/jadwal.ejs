<!DOCTYPE html>
<html>

<head>

    <title>Jadwal Kuliah</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

</head>

<body>

    <div class="container mt-4">

        <div class="d-flex justify-content-between align-items-center mb-4">

            <h2>Jadwal Kuliah</h2>

            <a href="/logout" class="btn btn-danger">
                Logout
            </a>

        </div>

        <a href="/dashboard" class="btn btn-secondary mb-3">

            Dashboard

        </a>

        <a href="/jadwal/tambah" class="btn btn-success mb-3">

            Tambah Jadwal

        </a>

        <table class="table table-bordered">

            <thead>

                <tr>

                    <th>No</th>
                    <th>Mata Kuliah</th>
                    <th>Dosen</th>
                    <th>Semester</th>
                    <th>Kelas</th>
                    <th>Hari</th>
                    <th>Jam Mulai</th>
                    <th>Jam Selesai</th>
                    <th>Ruangan</th>

                </tr>

            </thead>

            <tbody>

                <% data.forEach((j,index)=>{ %>

                    <tr>

                        <td>
                            <%= index+1 %>
                        </td>
                        <td>
                            <%= j.nama_mk %>
                        </td>

                        <td>
                            <%= j.nama_dosen %>
                        </td>
                        <td>
                            <%= j.semester %>
                        </td>
                        <td>
                            <%= j.kelas %>
                        </td>
                        <td>
                            <%= j.hari %>
                        </td>
                        <td>
                            <%= j.jam_mulai %>
                        </td>
                        <td>
                            <%= j.jam_selesai %>
                        </td>
                        <td>
                            <%= j.ruangan %>
                        </td>

                        <td>

                            <a href="/jadwal/edit/<%= j.id_jadwal %>" class="btn btn-warning btn-sm">
                                Edit
                            </a>

                            <a href="/jadwal/hapus/<%= j.id_jadwal %>" class="btn btn-danger btn-sm"
                                onclick="return confirm('Hapus data?')">
                                Hapus
                            </a>

                        </td>

                    </tr>

                    <% }) %>

            </tbody>

        </table>

    </div>

</body>

</html>