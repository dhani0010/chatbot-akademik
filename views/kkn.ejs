<!DOCTYPE html>
<html>

<head>
    <title>Data KKN</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body>

    <div class="container mt-4">

        <h1>Data KKN</h1>

        <a href="/dashboard" class="btn btn-secondary mb-3">
            Dashboard
        </a>

        <a href="/kkn/tambah" class="btn btn-success mb-3">
            + Tambah KKN
        </a>

        <table class="table table-bordered">

            <thead>

                <tr>
                    <th>ID</th>
                    <th>Mahasiswa</th>
                    <th>Lokasi</th>
                    <th>Kelompok</th>
                    <th>Dosen Pembimbing</th>
                    <th>Periode</th>
                    <th>Status</th>
                    <th>Aksi</th>
                </tr>

            </thead>

            <tbody>

                <% if(data.length> 0){ %>

                    <% data.forEach(item=>{ %>

                        <tr>

                            <td>
                                <%= item.id_kkn %>
                            </td>

                            <td>
                                <%= item.nama_mahasiswa %>
                            </td>

                            <td>
                                <%= item.lokasi %>
                            </td>

                            <td>
                                <%= item.kelompok %>
                            </td>

                            <td>
                                <%= item.nama_dosen %>
                            </td>

                            <td>
                                <%= item.periode %>
                            </td>

                            <td>
                                <%= item.status %>
                            </td>

                            <td>

                                <a href="/kkn/edit/<%= item.id_kkn %>" class="btn btn-warning btn-sm">
                                    Edit
                                </a>

                                <a href="/kkn/hapus/<%= item.id_kkn %>" class="btn btn-danger btn-sm"
                                    onclick="return confirm('Hapus data?')">
                                    Hapus
                                </a>

                            </td>

                        </tr>

                        <% }) %>

                            <% } else { %>

                                <tr>
                                    <td colspan="8" class="text-center">
                                        Data KKN kosong
                                    </td>
                                </tr>

                                <% } %>

            </tbody>

        </table>

    </div>

</body>

</html>