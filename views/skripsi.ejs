<!DOCTYPE html>
<html>

<head>
    <title>Data Skripsi</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <div class="container mt-4">

        <h1>Data Skripsi</h1>

        <a href="/dashboard" class="btn btn-secondary mb-3">
            Dashboard
        </a>

        <a href="/skripsi/tambah" class="btn btn-success mb-3">
            + Tambah Skripsi
        </a>

        <table class="table table-bordered table-striped">

            <thead>

                <tr>
                    <th>No</th>
                    <th>Mahasiswa</th>
                    <th>Judul</th>
                    <th>Pembimbing</th>
                    <th>Tahun</th>
                    <th>Status</th>
                    <th>Aksi</th>
                </tr>

            </thead>

            <tbody>

                <% if(data && data.length> 0){ %>

                    <% data.forEach((s,index)=>{ %>

                        <tr>

                            <td>
                                <%= index + 1 %>
                            </td>
                            <td>
                                <%= s.nama_mahasiswa %>
                            </td>
                            <td>
                                <%= s.judul %>
                            </td>
                            <td>
                                <%= s.nama_pembimbing %>
                            </td>
                            <td>
                                <%= s.tahun %>
                            </td>
                            <td>
                                <%= s.status %>
                            </td>


                            <td>

                                <a href="/skripsi/edit/<%= s.id_skripsi %>" class="btn btn-warning btn-sm">
                                    Edit
                                </a>

                                <a href="/skripsi/hapus/<%= s.id_skripsi %>" class="btn btn-danger btn-sm"
                                    onclick="return confirm('Hapus data?')">
                                    Hapus
                                </a>

                            </td>

                        </tr>

                        <% }) %>

                            <% } else { %>

                                <tr>

                                    <td colspan="7" class="text-center">
                                        Belum ada data skripsi
                                    </td>

                                </tr>

                                <% } %>

            </tbody>

        </table>

    </div>

</body>

</html>