<!DOCTYPE html>
<html>

<head>

    <title>Tambah Mahasiswa</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

</head>

<body>

    <div class="container mt-4">

        <h1>Edit Data Skripsi</h1>

        <a href="/skripsi" class="btn btn-secondary mb-3">
            Kembali
        </a>

        <form action="/skripsi/edit/<%= skripsi.id_skripsi %>" method="POST">

            <div class="mb-3">
                <label>Mahasiswa</label>

                <select name="id_mahasiswa" class="form-control">

                    <% mahasiswa.forEach(m=>{ %>

                        <option value="<%= m.id_mahasiswa %>" <%=skripsi.id_mahasiswa==m.id_mahasiswa ? 'selected' : ''
                            %>>
                            <%= m.npm %> - <%= m.nama %>
                        </option>

                        <% }) %>

                </select>
            </div>

            <div class="mb-3">
                <label>Judul Skripsi</label>

                <textarea name="judul" class="form-control" required><%= skripsi.judul %></textarea>
            </div>

            <div class="mb-3">
                <label>Pembimbing</label>

                <select name="pembimbing" class="form-control">

                    <% dosen.forEach(d=>{ %>

                        <option value="<%= d.id_dosen %>" <%=skripsi.pembimbing==d.id_dosen ? 'selected' : '' %>>
                            <%= d.kode %> - <%= d.nama %>
                        </option>

                        <% }) %>

                </select>
            </div>

            <div class="mb-3">
                <label>Tahun</label>
                <input type="number" name="tahun" class="form-control" required>
            </div>

            <div class="mb-3">

                <label>Status</label>

                <select name="status" class="form-control">

                    <option value="Pengajuan" <%=skripsi.status==='Pengajuan' ? 'selected' : '' %>>
                        Pengajuan
                    </option>

                    <option value="Proses" <%=skripsi.status==='Proses' ? 'selected' : '' %>>
                        Proses
                    </option>

                    <option value="Disetujui" <%=skripsi.status==='Disetujui' ? 'selected' : '' %>>
                        Disetujui
                    </option>

                    <option value="Selesai" <%=skripsi.status==='Selesai' ? 'selected' : '' %>>
                        Selesai
                    </option>

                </select>

            </div>

            <div class="mb-3">

                <label>Tanggal Sidang</label>

                <input type="date" name="tanggal_sidang"
                    value="<%= skripsi.tanggal_sidang ? skripsi.tanggal_sidang.toISOString().split('T')[0] : '' %>"
                    class="form-control">

            </div>

            <button type="submit" class="btn btn-primary">

                Update

            </button>

        </form>

    </div>

</body>

</html>