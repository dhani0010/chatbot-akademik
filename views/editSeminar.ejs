<!DOCTYPE html>
<html>

<head>

    <title>Edit Seminar Proposal</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

</head>

<body>

<div class="container mt-4">

    <h1>Edit Seminar Proposal</h1>

    <a href="/seminar" class="btn btn-secondary mb-3">
        Kembali
    </a>

    <form action="/seminar/edit/<%= seminar.id %>" method="POST">

        <div class="mb-3">

            <label>Mahasiswa</label>

            <select name="id_mahasiswa" class="form-control">

                <% mahasiswa.forEach(m=>{ %>

                    <option
                        value="<%= m.id_mahasiswa %>"
                        <%= seminar.id_mahasiswa == m.id_mahasiswa ? 'selected' : '' %>
                    >
                        <%= m.npm %> - <%= m.nama %>
                    </option>

                <% }) %>

            </select>

        </div>

        <div class="mb-3">

            <label>Tanggal Seminar</label>

            <input
                type="date"
                name="tanggal"
                class="form-control"
                value="<%= seminar.tanggal ? seminar.tanggal.toISOString().split('T')[0] : '' %>"
                required>

        </div>

        <div class="mb-3">

            <label>Ruang</label>

            <input
                type="text"
                name="ruang"
                class="form-control"
                value="<%= seminar.ruang %>"
                required>

        </div>

        <div class="mb-3">

            <label>Dosen Pembimbing</label>

            <select name="pembimbing" class="form-control">

                <% dosen.forEach(d=>{ %>

                    <option
                        value="<%= d.id_dosen %>"
                        <%= seminar.pembimbing == d.id_dosen ? 'selected' : '' %>
                    >
                        <%= d.nama %>
                    </option>

                <% }) %>

            </select>

        </div>

        <div class="mb-3">

            <label>Penguji 1</label>

            <select name="penguji_1" class="form-control">

                <% dosen.forEach(d=>{ %>

                    <option
                        value="<%= d.id_dosen %>"
                        <%= seminar.penguji == d.id_dosen ? 'selected' : '' %>
                    >
                        <%= d.nama %>
                    </option>

                <% }) %>

            </select>

            <label>Penguji 2</label>

            <select name="penguji_2" class="form-control">

                <% dosen.forEach(d=>{ %>

                    <option value="<%= d.id_dosen %>">
                        <%= d.nama %>
                    </option>

                    <% }) %>

            </select>

        </div>

        <button
            type="submit"
            class="btn btn-primary">

            Update

        </button>

    </form>

</div>

</body>
</html>