<!DOCTYPE html>
<html>

<head>

    <title>Data Notifikasi</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

</head>

<body>

    <div class="container mt-4">

        <h1>Data Notifikasi</h1>

        <a href="/dashboard" class="btn btn-secondary mb-3">
            Dashboard
        </a>

        <a href="/notifikasi/tambah" class="btn btn-success mb-3">
            + Tambah Notifikasi
        </a>

        <table class="table table-bordered">

            <thead>

                <tr>

                    <th>No</th>
                    <th>Mahasiswa</th>
                    <th>Judul</th>
                    <th>Pesan</th>
                    <th>Tanggal</th>
                    <th>Status</th>
                    <th>Aksi</th>

                </tr>

            </thead>

            <tbody>

                <% if(data && data.length> 0){ %>

                <% data.forEach((n,index)=>{ %>

                    <tr>

                        <td>
                            <%= index+1 %>
                        </td>

                        <td>
                            <%= n.nama %>
                        </td>

                        <td>
                            <%= n.judul %>
                        </td>

                        <td>
                            <%= n.pesan %>
                        </td>

                        <td>
                            <%= new Date(n.tanggal).toLocaleDateString('id-ID') %>
                        </td>

                        <td>
                            <%= n.status %>
                        </td>

                        <td>

                            <a href="/notifikasi/edit/<%= n.id %>" class="btn btn-warning btn-sm">
                                Edit
                            </a>

                            <a href="/notifikasi/hapus/<%= n.id %>" class="btn btn-danger btn-sm"
                                onclick="return confirm('Hapus data?')">
                                Hapus
                            </a>

                        </td>

                    </tr>

                    <% }) %>

                    <% } else { %>

                                <tr>

                                    <td colspan="7" class="text-center">
                                        Belum ada data notifikasi
                                    </td>

                                </tr>

                                <% } %>

            </tbody>

        </table>

    </div>

</body>

</html>