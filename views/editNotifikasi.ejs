<!DOCTYPE html>
<html>

<head>

<title>Edit Notifikasi</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

</head>

<body>

<div class="container mt-4">

<h1>Edit Notifikasi</h1>

<form
action="/notifikasi/edit/<%= notifikasi.id %>"
method="POST">

<div class="mb-3">

<label>Mahasiswa</label>

<select
name="id_mahasiswa"
class="form-control">

<% mahasiswa.forEach(m=>{ %>

<option
value="<%= m.id_mahasiswa %>"
<%= notifikasi.id_mahasiswa == m.id_mahasiswa ? 'selected' : '' %>>

<%= m.npm %> - <%= m.nama %>

</option>

<% }) %>

</select>

</div>

<div class="mb-3">
<label>Judul</label>
<input
type="text"
name="judul"
value="<%= notifikasi.judul %>"
class="form-control">
</div>

<div class="mb-3">
<label>Pesan</label>
<textarea
name="pesan"
class="form-control"><%= notifikasi.pesan %></textarea>
</div>

<div class="mb-3">
<label>Tanggal</label>
<input
type="date"
name="tanggal"
value="<%= notifikasi.tanggal %>"
class="form-control">
</div>

<div class="mb-3">

<label>Status</label>

<select
name="status"
class="form-control">

<option
value="Belum Dibaca"
<%= notifikasi.status == 'Belum Dibaca' ? 'selected' : '' %>>
Belum Dibaca
</option>

<option
value="Dibaca"
<%= notifikasi.status == 'Dibaca' ? 'selected' : '' %>>
Dibaca
</option>

</select>

</div>

<button class="btn btn-primary">
Update
</button>

</form>

</div>

</body>
</html>