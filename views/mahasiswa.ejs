<!DOCTYPE html>
<html>

<head>
    <title>Data Mahasiswa</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <div class="container mt-4">

        <div class="d-flex justify-content-between align-items-center mb-4">

            <h2>Data Mahasiswa</h2>

            <a href="/logout" class="btn btn-danger">
                Logout
            </a>

        </div>

        <div class="mb-3">

            <a href="/dashboard" class="btn btn-secondary">
                Dashboard
            </a>

            <a href="/mahasiswa/tambah" class="btn btn-success">
                + Tambah Mahasiswa
            </a>

        </div>

        <div class="card shadow">

            <div class="card-body">

                <table class="table table-bordered table-hover">

                    <thead class="table-primary">

                        <tr>
                            <th>No</th>
                            <th>NPM</th>
                            <th>Nama</th>
                            <th>Jenis Kelamin</th>
                            <th>No HP</th>
                            <th>Angkatan</th>
                            <th>Status</th>
                            <th>Semester</th>
                            <th>Aksi</th>
                        </tr>

                    </thead>

                    <tbody>

                        <% if(data && data.length> 0){ %>

                            <% data.forEach((m,index)=>{ %>

                                <tr>

                                    <td>
                                        <%= index+1 %>
                                    </td>
                                    <td>
                                        <%= m.npm %>
                                    </td>
                                    <td>
                                        <%= m.nama %>
                                    </td>
                                    <td>
                                        <%= m.jenis_kelamin %>
                                    </td>
                                    <td>
                                        <%= m.no_hp %>
                                    </td>
                                    <td>
                                        <%= m.angkatan %>
                                    </td>
                                    <td>
                                        <%= m.status_mahasiswa %>
                                    </td>
                                    <td>
                                        <% if(m.status_mahasiswa==='Alumni' ){ %>
                                            -
                                            <% } else { %>
                                                <%= m.semester %>
                                                    <% } %>
                                    </td>

                                    <td>

                                        <a href="/mahasiswa/edit/<%= m.id_mahasiswa %>" class="btn btn-warning btn-sm">
                                            Edit
                                        </a>

                                        <a href="/mahasiswa/hapus/<%= m.id_mahasiswa %>" class="btn btn-danger btn-sm">
                                            Hapus
                                        </a>

                                    </td>

                                </tr>

                                <% }) %>

                                    <% } else { %>

                                        <tr>

                                            <td colspan="8" class="text-center">
                                                Belum ada data mahasiswa
                                            </td>

                                        </tr>

                                        <% } %>

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</body>

</html>