<!DOCTYPE html>
<html>
<head>

<title>Edit Dokumen</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

</head>
<body>

<div class="container mt-4">

<h1>Edit Dokumen</h1>

<form action="/dokumen/edit/<%= dokumen.id %>"
      method="POST">

    <div class="mb-3">
        <label>Nama Dokumen</label>
        <input type="text"
               name="nama"
               value="<%= dokumen.nama %>"
               class="form-control">
    </div>

    <div class="mb-3">
        <label>Kategori</label>
        <input type="text"
               name="kategori"
               value="<%= dokumen.kategori %>"
               class="form-control">
    </div>

    <div class="mb-3">
        <label>Nama File</label>
        <input type="text"
               name="file"
               value="<%= dokumen.file %>"
               class="form-control">
    </div>

    <div class="mb-3">
        <label>Tanggal Upload</label>
        <input type="date"
               name="upload"
               value="<%= dokumen.upload ? dokumen.upload.toISOString().split('T')[0] : '' %>"
               class="form-control">
    </div>

    <button class="btn btn-primary">
        Update
    </button>

</form>

</div>

</body>
</html>