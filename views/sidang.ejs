<!DOCTYPE html>
<html>

<head>

    <title>Data Sidang</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

</head>

<body>

<div class="container mt-4">

    <h1>Data Sidang Skripsi</h1>

    <a href="/dashboard" class="btn btn-secondary mb-3">
        Dashboard
    </a>

    <a href="/sidang/tambah" class="btn btn-success mb-3">
        + Tambah Sidang
    </a>

    <table class="table table-bordered table-striped">

        <thead>

            <tr>

                <th>ID</th>
                <th>Mahasiswa</th>
                <th>Tanggal</th>
                <th>Jam</th>
                <th>Ruang</th>
                <th>Pembimbing</th>
                <th>Penguji 1</th>
                <th>Penguji 2</th>
                <th>Penguji 3</th>
                <th>Aksi</th>

            </tr>

        </thead>

        <tbody>

        <% if(data.length > 0){ %>

            <% data.forEach(item=>{ %>

            <tr>

                <td><%= item.id_sidang %></td>

                <td>
                    <%= item.nama_mahasiswa %>
                </td>

                <td>
                    <%= new Date(item.tanggal).toLocaleDateString('id-ID') %>
                </td>

                <td>
                    <%= item.jam %>
                </td>

                <td>
                    <%= item.ruang %>
                </td>

                <td>
                    <%= item.pembimbing %>
                </td>

                <td>
                    <%= item.nama_penguji1 %>
                </td>

                <td>
                    <%= item.nama_penguji2 %>
                </td>

                <td>
                    <%= item.nama_penguji3 %>
                </td>

                <td>

                    <a href="/sidang/edit/<%= item.id_sidang %>"
                       class="btn btn-warning btn-sm">
                        Edit
                    </a>

                    <a href="/sidang/hapus/<%= item.id_sidang %>"
                       class="btn btn-danger btn-sm"
                       onclick="return confirm('Hapus data?')">
                        Hapus
                    </a>

                </td>

            </tr>

            <% }) %>

        <% } else { %>

            <tr>

                <td colspan="9" class="text-center">
                    Belum ada data sidang
                </td>

            </tr>

        <% } %>

        </tbody>

    </table>

</div>

</body>
</html>