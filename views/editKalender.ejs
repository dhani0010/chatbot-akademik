<!DOCTYPE html>
<html>

<head>

    <title>Edit Kalender Akademik</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

</head>

<body>

<div class="container mt-4">

    <h1>Edit Kalender Akademik</h1>

    <a href="/kalender"
       class="btn btn-secondary mb-3">
       Kembali
    </a>

    <form action="/kalender/edit/<%= kalender.id %>" method="POST">

        <div class="mb-3">

            <label>Kegiatan</label>

            <input type="text"
                   name="kegiatan"
                   class="form-control"
                   value="<%= kalender.kegiatan %>"
                   required>

        </div>

        <div class="mb-3">

            <label>Tanggal Mulai</label>

            <input type="date"
                   name="tanggal_mulai"
                   class="form-control"
                   value="<%= kalender.tanggal_mulai.toISOString().split('T')[0] %>">

        </div>

        <div class="mb-3">

            <label>Tanggal Selesai</label>

            <input type="date"
                   name="tanggal_selesai"
                   class="form-control"
                   value="<%= kalender.tanggal_selesai.toISOString().split('T')[0] %>">

        </div>

        <div class="mb-3">

            <label>Kategori</label>

            <input type="text"
                   name="kategori"
                   class="form-control"
                   value="<%= kalender.kategori %>">

        </div>

        <button class="btn btn-primary">

            Update

        </button>

    </form>

</div>

</body>
</html>