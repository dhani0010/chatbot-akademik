<!DOCTYPE html>
<html>

<head>

    <title>Data Seminar</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

</head>

<body>

    <div class="container mt-4">

        <h1>Data Seminar</h1>

        <a href="/dashboard" class="btn btn-secondary mb-3">
            Dashboard
        </a>

        <a href="/seminar/tambah" class="btn btn-success mb-3">
            + Tambah Seminar
        </a>

        <table class="table table-bordered">

            <thead>

                <tr>

                    <th>ID</th>
                    <th>Mahasiswa</th>
                    <th>Tanggal</th>
                    <th>Ruang</th>
                    <th>Pembimbing</th>
                    <th>Penguji 1</th>
                    <th>Penguji 2</th>
                    <th>Aksi</th>

                </tr>

            </thead>

            <tbody>

                <% data.forEach(item=>{ %>

                    <tr>

                        <td>
                            <%= item.id %>
                        </td>

                        <td>
                            <%= item.nama_mahasiswa %>
                        </td>

                        <td>
                            <%= new Date(item.tanggal) .toLocaleDateString('id-ID') %>
                        </td>

                        <td>
                            <%= item.ruang %>
                        </td>

                        <td>
                            <%= item.nama_pembimbing %>
                        </td>

                        <td>
                            <%= item.nama_penguji_1 %>
                        </td>

                        <td>
                            <%= item.nama_penguji_2 %>
                        </td>

                        <td>

                            <a href="/seminar/edit/<%= item.id %>" class="btn btn-warning btn-sm">
                                Edit
                            </a>

                            <a href="/seminar/hapus/<%= item.id %>" class="btn btn-danger btn-sm"
                                onclick="return confirm('Hapus data?')">
                                Hapus
                            </a>

                        </td>

                    </tr>

                    <% }) %>

            </tbody>

        </table>

    </div>

</body>

</html>