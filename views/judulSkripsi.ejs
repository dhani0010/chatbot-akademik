<!DOCTYPE html>
<html>

<head>

    <title>Data Judul Skripsi</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

</head>

<body>

    <div class="container mt-4">

        <h1>Data Judul Skripsi</h1>

        <a href="/dashboard" class="btn btn-secondary mb-3">
            Dashboard
        </a>

        <a href="/judulSkripsi/tambah" class="btn btn-success mb-3">
            + Tambah Judul Skripsi
        </a>

        <table class="table table-bordered">

            <thead>

                <tr>

                    <th>No</th>
                    <th>Judul</th>
                    <th>Mahasiswa</th>
                    <th>Tahun</th>
                    <th>Dosen Pembimbing 1</th>
                    <th>Dosen Pembimbing 2</th>
                    <th>Aksi</th>

                </tr>

            </thead>

            <tbody>

                <% if(data.length> 0){ %>

                    <% data.forEach((js,index)=>{ %>

                        <tr>

                            <td>
                                <%= index + 1 %>
                            </td>

                            <td>
                                <%= js.judul %>
                            </td>

                            <td>
                                <%= js.nama_mahasiswa %>
                            </td>

                            <td>
                                <%= js.tahun %>
                            </td>

                            <td>
                                <%= js.nama_pembimbing_1 || '-' %>
                            </td>
                            <td>
                                <%= js.nama_pembimbing_2 || '-' %>
                            </td>

                            <td>

                                <a href="/judulSkripsi/edit/<%= js.id_judul %>" class="btn btn-warning btn-sm">
                                    Edit
                                </a>

                                <a href="/judulSkripsi/hapus/<%= js.id_judul %>" class="btn btn-danger btn-sm"
                                    onclick="return confirm('Yakin hapus data?')">
                                    Hapus
                                </a>

                            </td>

                        </tr>

                        <% }) %>

                            <% } else { %>

                                <tr>

                                    <td colspan="6" class="text-center">
                                        Belum ada data
                                    </td>

                                </tr>

                                <% } %>

            </tbody>

        </table>

    </div>

</body>

</html>