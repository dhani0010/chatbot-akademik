<!DOCTYPE html>
<html lang="id">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>Dashboard Admin</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        body {
            background: #f4f6f9;
        }

        .dashboard-card {
            border: none;
            border-radius: 20px;
            transition: .3s;
        }

        .dashboard-card:hover {
            transform: translateY(-5px);
        }

        .menu-icon {
            font-size: 50px;
        }
    </style>

</head>

<body>

    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">

        <div class="container">

            <span class="navbar-brand fw-bold">
                Chatbot Akademik Sistem Informasi
            </span>

            <a href="/logout" class="btn btn-danger">
                Logout
            </a>

        </div>

    </nav>

    <div class="container mt-4">

        <!-- Welcome -->

        <div class="card shadow border-0 rounded-4">

            <div class="card-body p-4">

                <h1 class="fw-bold">
                    Selamat Datang, Admin 👋
                </h1>

                <p class="text-muted fs-5">
                    Dashboard Pengelolaan Chatbot WhatsApp Akademik
                </p>

            </div>

        </div>

        <!-- Menu -->

        <div class="row mt-4 g-4">

            <!-- Mahasiswa -->
            <div class="col-lg-3 col-md-4 col-sm-6">
                <div class="card dashboard-card shadow text-center h-100">
                    <div class="card-body">
                        <i class="bi bi-mortarboard-fill menu-icon text-primary"></i>
                        <h5 class="mt-3">Mahasiswa</h5>
                        <p>Kelola data mahasiswa</p>
                        <a href="/mahasiswa" class="btn btn-primary">Buka Menu</a>
                    </div>
                </div>
            </div>

            <!-- Dosen -->
            <div class="col-lg-3 col-md-4 col-sm-6">
                <div class="card dashboard-card shadow text-center h-100">
                    <div class="card-body">
                        <i class="bi bi-person-workspace menu-icon text-success"></i>
                        <h5 class="mt-3">Dosen</h5>
                        <p>Kelola data dosen</p>
                        <a href="/dosen" class="btn btn-success">Buka Menu</a>
                    </div>
                </div>
            </div>

            <!-- Mata Kuliah -->
            <div class="col-lg-3 col-md-4 col-sm-6">
                <div class="card dashboard-card shadow text-center h-100">
                    <div class="card-body">
                        <i class="bi bi-book-fill menu-icon text-warning"></i>
                        <h5 class="mt-3">Mata Kuliah</h5>
                        <p>Kelola mata kuliah</p>
                        <a href="/matakuliah" class="btn btn-warning">Buka Menu</a>
                    </div>
                </div>
            </div>

            <!-- Jadwal -->
            <div class="col-lg-3 col-md-4 col-sm-6">
                <div class="card dashboard-card shadow text-center h-100">
                    <div class="card-body">
                        <i class="bi bi-calendar-week-fill menu-icon text-info"></i>
                        <h5 class="mt-3">Jadwal Kuliah</h5>
                        <p>Kelola jadwal kuliah</p>
                        <a href="/jadwal" class="btn btn-info">Buka Menu</a>
                    </div>
                </div>
            </div>

            <!-- Skripsi -->
            <div class="col-lg-3 col-md-4 col-sm-6">
                <div class="card dashboard-card shadow text-center h-100">
                    <div class="card-body">
                        <i class="bi bi-journal-text menu-icon text-danger"></i>
                        <h5 class="mt-3">Skripsi</h5>
                        <p>Data skripsi mahasiswa</p>
                        <a href="/skripsi" class="btn btn-danger">Buka Menu</a>
                    </div>
                </div>
            </div>

            <!-- Judul Skripsi -->
            <div class="col-lg-3 col-md-4 col-sm-6">
                <div class="card dashboard-card shadow text-center h-100">
                    <div class="card-body">
                        <i class="bi bi-pencil-square menu-icon text-secondary"></i>
                        <h5 class="mt-3">Judul Skripsi</h5>
                        <p>Kelola judul skripsi</p>
                        <a href="/judulSkripsi" class="btn btn-secondary">Buka Menu</a>
                    </div>
                </div>
            </div>

            <!-- KP -->
            <div class="col-lg-3 col-md-4 col-sm-6">
                <div class="card dashboard-card shadow text-center h-100">
                    <div class="card-body">
                        <i class="bi bi-building menu-icon text-dark"></i>
                        <h5 class="mt-3">Kerja Praktik</h5>
                        <p>Kelola data KP</p>
                        <a href="/kp" class="btn btn-dark">Buka Menu</a>
                    </div>
                </div>
            </div>

            <!-- KKN -->
            <div class="col-lg-3 col-md-4 col-sm-6">
                <div class="card dashboard-card shadow text-center h-100">
                    <div class="card-body">
                        <i class="bi bi-globe2 menu-icon text-success"></i>
                        <h5 class="mt-3">KKN</h5>
                        <p>Kelola data KKN</p>
                        <a href="/kkn" class="btn btn-success">Buka Menu</a>
                    </div>
                </div>
            </div>

            <!-- Kalender -->
            <div class="col-lg-3 col-md-4 col-sm-6">
                <div class="card dashboard-card shadow text-center h-100">
                    <div class="card-body">
                        <i class="bi bi-calendar-event-fill menu-icon text-info"></i>
                        <h5 class="mt-3">Kalender Akademik</h5>
                        <p>Kelola kalender akademik</p>
                        <a href="/kalender" class="btn btn-info">Buka Menu</a>
                    </div>
                </div>
            </div>

            <!-- Pengumuman -->
            <div class="col-lg-3 col-md-4 col-sm-6">
                <div class="card dashboard-card shadow text-center h-100">
                    <div class="card-body">
                        <i class="bi bi-megaphone-fill menu-icon text-danger"></i>
                        <h5 class="mt-3">Pengumuman</h5>
                        <p>Kelola pengumuman</p>
                        <a href="/pengumuman" class="btn btn-danger">Buka Menu</a>
                    </div>
                </div>
            </div>

            <!-- FAQ -->
            <div class="col-lg-3 col-md-4 col-sm-6">
                <div class="card dashboard-card shadow text-center h-100">
                    <div class="card-body">
                        <i class="bi bi-question-circle-fill menu-icon text-secondary"></i>
                        <h5 class="mt-3">FAQ</h5>
                        <p>Kelola FAQ chatbot</p>
                        <a href="/faq" class="btn btn-secondary">Buka Menu</a>
                    </div>
                </div>
            </div>

            <!-- Log Chatbot -->
            <div class="col-lg-3 col-md-4 col-sm-6">
                <div class="card dashboard-card shadow text-center h-100">
                    <div class="card-body">
                        <i class="bi bi-robot menu-icon text-dark"></i>
                        <h5 class="mt-3">Log Chatbot</h5>
                        <p>Monitoring chatbot</p>
                        <a href="/chatbotLog" class="btn btn-dark">Buka Menu</a>
                    </div>
                </div>
            </div>

            <!-- Dokumen -->
            <div class="col-lg-3 col-md-4 col-sm-6">
                <div class="card dashboard-card shadow text-center h-100">
                    <div class="card-body">
                        <i class="bi bi-folder-fill menu-icon text-primary"></i>
                        <h5 class="mt-3">Dokumen Akademik</h5>
                        <p>Kelola dokumen</p>
                        <a href="/dokumen" class="btn btn-primary">Buka Menu</a>
                    </div>
                </div>
            </div>

        </div>

        <!-- Informasi Sistem -->

        <div class="card shadow mt-5">

            <div class="card-header bg-dark text-white">
                Informasi Sistem
            </div>

            <div class="card-body">

                <table class="table">

                    <tr>
                        <td width="30%">Nama Sistem</td>
                        <td>Chatbot WhatsApp Akademik</td>
                    </tr>

                    <tr>
                        <td>Program Studi</td>
                        <td>Sistem Informasi</td>
                    </tr>

                    <tr>
                        <td>Platform</td>
                        <td>WhatsApp Web API</td>
                    </tr>

                    <tr>
                        <td>Database</td>
                        <td>MySQL</td>
                    </tr>

                    <tr>
                        <td>Framework</td>
                        <td>Node.js, Express.js, EJS</td>
                    </tr>

                </table>

            </div>

        </div>

    </div>

</body>

</html>
