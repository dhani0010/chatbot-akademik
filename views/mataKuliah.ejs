<!DOCTYPE html>
<html>
<head>
    <title>Data Mata Kuliah</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>

<div class="container mt-4">

    <h1>Data Mata Kuliah</h1>

    <a href="/dashboard" class="btn btn-secondary mb-3">
        Dashboard
    </a>

    <a href="/matakuliah/tambah" class="btn btn-success mb-3">
        + Tambah Mata Kuliah
    </a>

    <table class="table table-bordered">

        <thead>

            <tr>
                <th>No</th>
                <th>Kode MK</th>
                <th>Nama Mata Kuliah</th>
                <th>SKS</th>
                <th>Semester</th>
                <th>Aksi</th>
            </tr>

        </thead>

        <tbody>

        <% if(data.length > 0){ %>

            <% data.forEach((item,index)=>{ %>

            <tr>

                <td><%= index+1 %></td>
                <td><%= item.kode_mk %></td>
                <td><%= item.nama_mk %></td>
                <td><%= item.sks %></td>
                <td><%= item.semester %></td>

                <td>

                    <a href="/matakuliah/edit/<%= item.id_mk %>"
                    class="btn btn-warning btn-sm">
                    Edit
                    </a>

                    <a href="/matakuliah/hapus/<%= item.id_mk %>"
                    class="btn btn-danger btn-sm"
                    onclick="return confirm('Hapus data?')">
                    Hapus
                    </a>

                </td>

            </tr>

            <% }) %>

        <% } else { %>

            <tr>

                <td colspan="6" class="text-center">
                    Data Mata Kuliah Kosong
                </td>

            </tr>

        <% } %>

        </tbody>

    </table>

</div>

</body>
</html>