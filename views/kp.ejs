<!DOCTYPE html>
<html>

<head>
    <title>Data Mahasiswa</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <link rel="stylesheet" href="/css/style.css">
</head>

<div class="container mt-4">

    <h1>Data KP</h1>

    <a href="/dashboard" class="btn btn-secondary mb-3">
        Dashboard
    </a>

    <a href="/kp/tambah" class="btn btn-success mb-3">
        + Tambah KP
    </a>

    <table class="table table-bordered">

        <thead>

            <tr>
                <th>No</th>
                <th>Mahasiswa</th>
                <th>Judul</th>
                <th>Dosen Pembimbing</th>
                <th>Tahun</th>
                <th>Aksi</th>
            </tr>

        </thead>

        <tbody>

            <% if(data.length> 0){ %>

                <% data.forEach((item,index)=>{ %>

                    <tr>

                        <td>
                            <%= index+1 %>
                        </td>

                        <td>
                            <%= item.nama_mahasiswa %>
                        </td>

                        <td>
                            <%= item.judul %>
                        </td>

                        <td>
                            <%= item.nama_dosen %>
                        </td>

                        <td>
                            <%= item.tahun %>
                        </td>


                        <td>

                            <a href="/kp/edit/<%= item.id_kp %>" class="btn btn-warning btn-sm">
                                Edit
                            </a>

                            <a href="/kp/hapus/<%= item.id_kp %>" class="btn btn-danger btn-sm"
                                onclick="return confirm('Hapus data?')">
                                Hapus
                            </a>

                        </td>

                    </tr>

                    <% }) %>

                        <% } else { %>

                            <tr>
                                <td colspan="8" class="text-center">
                                    Data KP kosong
                                </td>
                            </tr>

                            <% } %>

        </tbody>

    </table>

</div>

</body>

</html>